# Firebase project ID from the Firebase console.
FIREBASE_PROJECT_ID=your-firebase-project-id

# Absolute path to a Firebase Admin service-account JSON file.
# Keep that file outside this repository and never put its contents in the app.
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/firebase-admin-service-account.json

# Optional: change this if you use a different Firestore collection name.
FIRESTORE_PRODUCTS_COLLECTION=products

# For UI development before Firebase is configured, set this to true.
# The health endpoint will report local-seed instead of Firestore.
USE_LOCAL_PRODUCT_SEED=false

PORT=3000
